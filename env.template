# ============================================
# EventOrg SaaS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# DATABASE (PostgreSQL) - REQUIRED
# ============================================
# For Vercel/Serverless: Use TRANSACTION pooler (port 6543) with ?pgbouncer=true&connection_limit=1
# For Local Development: Use SESSION pooler (port 5432) or direct connection
# 
# Supabase Transaction Pooler (REQUIRED for Production/Vercel):
# MUST include ?pgbouncer=true&connection_limit=1 to prevent "prepared statement already exists" errors
DATABASE_URL="postgresql://postgres:your-password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"

# Optional: Direct connection for migrations (bypasses pooler)
# Use this for prisma db push, prisma migrate, prisma studio
# Get from: Supabase Dashboard > Settings > Database > Connection String (Session mode, port 5432)
# DATABASE_DIRECT_URL="postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres?schema=public"

# ============================================
# CLERK AUTHENTICATION - REQUIRED
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk Webhook Secret (for syncing organizations)
# Get this from Clerk Dashboard > Webhooks > Endpoint > Signing Secret
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# STRIPE PAYMENTS - REQUIRED for Payments
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_ID_MONTHLY="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_ID_MONTHLY_PRO="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# PLAN LIMITS (Optional - Override defaults)
# ============================================
# Free Plan Limits
# PLAN_LIMIT_FREE_WHATSAPP=60
# PLAN_LIMIT_FREE_AI=10

# Monthly Plan Limits
# PLAN_LIMIT_MONTHLY_WHATSAPP=300
# PLAN_LIMIT_MONTHLY_AI=60

# Monthly Pro Plan Limits
# PLAN_LIMIT_MONTHLY_PRO_WHATSAPP=1000
# PLAN_LIMIT_MONTHLY_PRO_AI=200

# Internal Contact Soft Cap (abuse protection, not user-facing)
# PLAN_LIMIT_CONTACTS_SOFT_CAP=10000

# ============================================
# TWILIO WHATSAPP - REQUIRED for WhatsApp
# ============================================
# Get these from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token-here"
# WhatsApp sender number in format: whatsapp:+14155238886
# This is your Twilio WhatsApp-enabled phone number
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ============================================
# CLOUDINARY - REQUIRED for Image Uploads
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret-here"

# ============================================
# AI/LLM (OpenAI) - OPTIONAL
# ============================================
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# APPLICATION URL - REQUIRED
# ============================================
# For Production: Use your domain (e.g., https://lexnify.com)
# For Local Development: Use http://localhost:3000
NEXT_PUBLIC_APP_URL="https://lexnify.com"

# ============================================
# SENTRY ERROR TRACKING - OPTIONAL
# ============================================
# Get these from Sentry Dashboard: https://sentry.io/
# Free tier available: https://sentry.io/pricing/
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
# SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"

# ============================================
# ADMIN EMAILS - REQUIRED for Analytics Access
# ============================================
# Comma-separated list of admin email addresses that can access the analytics dashboard
# Must use NEXT_PUBLIC_ prefix so it's accessible in client components (sidebar)
# Example: NEXT_PUBLIC_ADMIN_EMAILS="admin@example.com,admin2@example.com"
NEXT_PUBLIC_ADMIN_EMAILS="admin@example.com"