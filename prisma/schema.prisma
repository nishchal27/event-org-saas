// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User table - lightweight, linked to Clerk
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

// Organization table - tenant boundary
model Organization {
  id              String   @id @default(cuid())
  clerkOrgId      String   @unique
  name            String
  slug            String   @unique
  logo            String?
  accentColor     String?  @default("#3b82f6")
  backgroundColor String?  @default("light")
  fontStyle       String?  @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships  Membership[]
  subscription Subscription?
  events       Event[]
  contacts     Contact[]
  usage        Usage[]
  socialPosts  SocialMediaPost[]

  @@map("organizations")
}

// Membership table - links users to organizations
model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           String @default("admin") // "admin" | "member" (future)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan                 String // "free" | "monthly" | "monthly_pro" | "enterprise"
  status               String // "active" | "canceled" | "past_due"
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Usage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  month          Int // 1-12
  year           Int
  eventsCreated  Int @default(0)
  contactsCount  Int @default(0)
  whatsappSent   Int @default(0)
  aiGenerations  Int @default(0)
  aiTokensUsed   Int @default(0) // Track total tokens used for AI
  postsGenerated Int @default(0) // Track number of posts generated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, month, year])
  @@map("usage")
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title           String
  imageUrl        String?
  eventDate       DateTime
  startTime       String
  endTime         String?
  locationType    String // "physical" | "online"
  location        String
  description     String   @db.Text
  additionalNotes String?  @db.Text

  audienceType String // "all" | "selected" | "public"
  isPublic     Boolean @default(false)
  publicSlug   String  @unique

  customField1Label String?
  customField1Value String?
  customField2Label String?
  customField2Value String?

  registrationClosed Boolean   @default(false)
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees        Attendee[]
  selectedContacts EventContact[]
  socialPosts      SocialMediaPost[]

  @@map("events")
}

model EventContact {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, contactId])
  @@map("event_contacts")
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  phone    String
  email    String?
  tags     String[] // Array of tags
  location String?
  notes    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    EventContact[]
  attendees Attendee[]

  @@unique([organizationId, phone])
  @@map("contacts")
}

model Attendee {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  name   String
  phone  String
  email  String?
  status String // "confirmed" | "declined" | "maybe" | "pending"

  whatsappSent   Boolean   @default(false)
  whatsappSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, phone], name: "eventId_phone")
  @@map("attendees")
}

model SocialMediaPost {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  platform String // "instagram" | "facebook" | "twitter" | "linkedin" | "whatsapp"
  content  String   @db.Text
  hashtags String[] // Array of hashtags
  tone     String? // "friendly" | "formal" | "casual" | "professional" | "excited"
  status   String   @default("draft") // "draft" | "published" | "archived"

  // Optional metadata for better generation
  targetAudience String? // "general" | "youth" | "professionals" | "families"
  callToAction   String? // "register" | "learn-more" | "share" | "attend"
  customPrompt   String? @db.Text // User-provided additional context

  // Metrics
  tokensUsed     Int? // Track AI token usage
  generationTime Int? // Time taken in milliseconds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([organizationId])
  @@index([platform])
  @@map("social_media_posts")
}
